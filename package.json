{
  "name": "deja-boo",
  "version": "0.1.0",
  "description": "Your codebase remembers what it buried.",
  "type": "module",
  "bin": {
    "deja-boo": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --project tsconfig.build.json",
    "bury": "npm run build && node dist/cli/main.js index . --out .deja-boo/graveyard.json",
    "web": "vite web"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.22.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
