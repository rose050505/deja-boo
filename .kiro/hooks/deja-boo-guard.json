{
  "version": "v1",
  "hooks": [
    {
      "name": "deja-boo-guard",
      "trigger": "PreToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "node dist/cli/main.js hook"
      }
    },
    {
      "name": "deja-boo-stop-guard",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node dist/cli/main.js hook"
      }
    }
  ]
}
